/* 全局样式 */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: #333;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
}

/* 头部样式 */
header {
    background: rgba(255, 255, 255, 0.95);
    padding: 2rem;
    text-align: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #2c3e50;
}

header p {
    font-size: 1.2rem;
    color: #7f8c8d;
    margin-bottom: 1rem;
}

nav {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1rem;
}

nav a {
    text-decoration: none;
    color: #3498db;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    transition: all 0.3s ease;
}

nav a:hover {
    background: #3498db;
    color: white;
}

/* 主内容区 */
main {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 2rem;
}

section {
    background: white;
    margin: 2rem 0;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

h2 {
    color: #2c3e50;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
    border-bottom: 3px solid #3498db;
    padding-bottom: 0.5rem;
}

/* 概念卡片 */
.concept {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #3498db;
}

.concept ul {
    list-style: none;
    margin-top: 1rem;
}

.concept li {
    padding: 0.5rem 0;
    font-size: 1.1rem;
}

/* 机制网格 */
.mechanism-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
}

.mechanism-card {
    background: #f8f9fa;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #e74c3c;
    transition: transform 0.3s ease;
}

.mechanism-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
}

.mechanism-card h3 {
    color: #2c3e50;
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
}

.mechanism-card .tagline {
    font-style: italic;
    color: #7f8c8d;
    margin-bottom: 1rem;
}

.mechanism-card p {
    color: #555;
    font-size: 0.95rem;
}

/* 代码分析 */
.code-analysis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 1.5rem;
}

.code-block {
    background: #2c3e50;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
}

.code-block h3 {
    color: #ecf0f1;
    margin-bottom: 1rem;
    font-size: 1.2rem;
}

.code-block pre {
    margin: 0;
}

.code-block code {
    color: #ecf0f1;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 0.9rem;
    line-height: 1.4;
}

/* 架构图 */
.mermaid {
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    margin-top: 1rem;
}

/* 页脚 */
footer {
    background: rgba(255, 255, 255, 0.95);
    padding: 1.5rem;
    text-align: center;
    margin-top: 3rem;
    box-shadow: 0 -4px 6px rgba(0, 0, 0, 0.1);
}

footer a {
    color: #3498db;
    text-decoration: none;
}

footer a:hover {
    text-decoration: underline;
}

/* 响应式设计 */
@media (max-width: 768px) {
    header h1 {
        font-size: 2rem;
    }
    
    nav {
        flex-direction: column;
        gap: 1rem;
    }
    
    .mechanism-grid {
        grid-template-columns: 1fr;
    }
    
    .code-analysis {
        grid-template-columns: 1fr;
    }
}

/* ===== 代码切换标签 ===== */
.code-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 0;
    border-bottom: 2px solid #30363d;
    background: #161b22;
    border-radius: 8px 8px 0 0;
    overflow: hidden;
}

.code-tab {
    padding: 0.6rem 1.2rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 600;
    color: #8b949e;
    transition: all 0.2s ease;
    margin-bottom: -2px;
    letter-spacing: 0.02em;
    position: relative;
}

.code-tab:hover {
    background: rgba(88, 166, 255, 0.08);
    color: #c9d1d9;
}

.code-tab.active {
    background: #0d1117;
    color: #58a6ff;
    border-bottom-color: #58a6ff;
}

.code-tab.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: #58a6ff;
}

/* ===== 代码内容区域 ===== */
.code-content {
    position: relative;
    background: #0d1117;
    border-radius: 0 0 8px 8px;
    border: 1px solid #30363d;
    border-top: none;
    overflow: hidden;
}

.code-panel {
    display: none;
    margin: 0;
    padding: 0;
}

.code-panel.active {
    display: block;
}

.code-panel code {
    display: block;
    padding: 1.2rem 1.5rem;
    font-family: 'SF Mono', 'Fira Code', 'Cascadia Code', 'JetBrains Mono', Consolas, 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.7;
    color: #e6edf3;
    background: #0d1117;
    overflow-x: auto;
    white-space: pre;
    tab-size: 4;
    -webkit-font-smoothing: antialiased;
}

/* 语法高亮 — 关键字 */
.code-panel code .kw,
.code-panel code [class*="keyword"] {
    color: #ff7b72;
}

/* 语法高亮 — 字符串 */
.code-panel code .str,
.code-panel code [class*="string"] {
    color: #a5d6ff;
}

/* 语法高亮 — 注释 */
.code-panel code .cmt,
.code-panel code [class*="comment"] {
    color: #8b949e;
    font-style: italic;
}

/* 语法高亮 — 类型 */
.code-panel code .typ,
.code-panel code [class*="type"] {
    color: #79c0ff;
}

/* 语法高亮 — 数字 */
.code-panel code .num,
.code-panel code [class*="number"] {
    color: #79c0ff;
}

/* 语法高亮 — 函数 */
.code-panel code .fn,
.code-panel code [class*="function"] {
    color: #d2a8ff;
}

/* 代码块内联 code（非 code-panel） */
.code-panel code .op,
.code-panel code [class*="operator"] {
    color: #ff7b72;
}

/* 旧版兼容 — 机制页面的 code-block 容器 */
.code-block {
    margin: 1.5rem 0;
    border-radius: 8px;
    overflow: hidden;
}

.code-block > h3 {
    background: #161b22;
    padding: 0.8rem 1.2rem;
    margin: 0;
    font-size: 0.95rem;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
}

.code-block > pre {
    background: #0d1117;
    border: 1px solid #30363d;
    padding: 1.2rem 1.5rem;
    font-family: 'SF Mono', 'Fira Code', Consolas, monospace;
    font-size: 14px;
    line-height: 1.7;
    color: #e6edf3;
    overflow-x: auto;
    white-space: pre;
    margin: 0;
    border-radius: 0;
}

/* 普通 pre/code（无 code-tabs） */
pre code {
    font-family: 'SF Mono', 'Fira Code', Consolas, monospace;
    font-size: 14px;
    line-height: 1.7;
}

/* ===== 响应式 ===== */
@media (max-width: 768px) {
    .code-panel code {
        font-size: 13px;
        padding: 1rem;
        line-height: 1.6;
    }
    
    .code-tab {
        padding: 0.5rem 0.8rem;
        font-size: 0.8rem;
    }
    
    .code-tabs {
        border-radius: 6px 6px 0 0;
    }
    
    .code-content {
        border-radius: 0 0 6px 6px;
    }
    
    .code-block > pre {
        font-size: 13px;
        padding: 1rem;
    }
}

@media (max-width: 480px) {
    .code-panel code {
        font-size: 12px;
        padding: 0.8rem;
    }
    
    .code-tab {
        padding: 0.4rem 0.6rem;
        font-size: 0.75rem;
    }
}
