# 加载 GitHub 相关的 Skill
github_skill = cc.load_skill("github")
# 提供：仓库操作、Issue 管理、PR 创建

# 加载文件系统 Skill
fs_skill = cc.load_skill("filesystem")
# 提供：文件搜索、批量操作、目录分析</code></pre>
                </div>
            </div>
        </section>

        <section id="best-practices">
            <h2>💡 最佳实践</h2>
            <div class="best-practices">
                <div class="practice">
                    <h3>✅ 推荐做法</h3>
                    <ul>
                        <li>🎯 <strong>明确的描述</strong>：在 SKILL.md 中详细描述 Skill 的用途</li>
                        <li>🔑 <strong>清晰的触发词</strong>：设置准确的触发关键词</li>
                        <li>📝 <strong>完整的文档</strong>：包含使用示例和注意事项</li>
                        <li>🔄 <strong>版本管理</strong>：使用 Git 管理 Skill 版本</li>
                    </ul>
                </div>
                
                <div class="practice">
                    <h3>❌ 避免的做法</h3>
                    <ul>
                        <li>🚫 <strong>过于宽泛的描述</strong>：避免模糊的 Skill 定义</li>
                        <li>🚫 <strong>缺少触发词</strong>：不要让 Skill 难以被发现</li>
                        <li>🚫 <strong>过大的 Prompt</strong>：避免加载过多不必要的内容</li>
                        <li>🚫 <strong>没有测试</strong>：确保 Skill 在各种场景下都能工作</li>
                    </ul>
                </div>
            </div>
        </section>
            <section id="progressive-disclosure">
            <h2>🔍 渐进式披露机制 (Progressive Disclosure)</h2>
            
            <div class="concept">
                <p><strong>渐进式披露</strong>是 Claude Code Skills 的核心设计理念，它确保 AI 只在需要时加载必要的知识，避免上下文过载。</p>
                
                <div class="highlight">
                    <h3>🎯 核心原则</h3>
                    <ul>
                        <li>🔍 <strong>按需发现</strong> - 只在相关场景下发现 Skill</li>
                        <li>📦 <strong>按需加载</strong> - 只在需要时注入知识</li>
                        <li>🧹 <strong>自动清理</strong> - 任务完成后释放上下文</li>
                        <li>⚡ <strong>高效执行</strong> - 最小化 Token 消耗</li>
                    </ul>
                </div>
            </div>
            
            <div class="discovery-flow">
                <h3>🔄 渐进式披露流程</h3>
                <div class="mermaid">
                    graph TD
                        A[用户输入] --> B{关键词匹配?}
                        B -->|是| C[触发 Skill 发现]
                        B -->|否| D[正常对话]
                        C --> E[扫描 SKILL.md 文件]
                        E --> F[读取描述和触发器]
                        F --> G{匹配当前任务?}
                        G -->|是| H[注入 Skill 上下文]
                        G -->|否| I[跳过 Skill]
                        H --> J[执行任务]
                        J --> K[清理上下文]
                        K --> L[返回结果]
                        D --> M[继续对话]
                </div>
            </div>
            
            <div class="implementation-details">
                <h3>⚙️ 实现机制</h3>
                
                <div class="code-block-new">
                    <div class="code-block-header">
                        <div class="code-block-tabs">
                            <button class="code-block-tab active" data-lang="typescript">TypeScript</button>
                            <button class="code-block-tab " data-lang="python">Python</button>
                        </div>
                        <div class="code-block-actions">
                            <button class="code-block-action copy-btn">📋 复制</button>
                            <button class="code-block-action fullscreen-btn">⛶ 全屏</button>
                        </div>
                    </div>
                    <div class="code-block-content">
                        <pre class="code-block-panel active" data-lang="typescript"><code class="language-typescript">// Skill 发现和加载机制
interface SkillConfig {
    name: string;
    description: string;
    triggers: string[];  // 触发关键词
    files: string[];     // 相关文件
    priority: number;    // 加载优先级
}

class SkillManager {
    private skills: Map<string, SkillConfig> = new Map();
    
    // 渐进式发现：扫描目录中的 SKILL.md 文件
    async discoverSkills(directory: string): Promise<void> {
        const skillFiles = await glob(`${directory}/**/SKILL.md`);
        
        for (const file of skillFiles) {
            const content = await readFile(file);
            const skill = this.parseSkillFile(content);
            
            if (this.shouldLoadSkill(skill, currentContext)) {
                this.skills.set(skill.name, skill);
            }
        }
    }
    
    // 按需加载：只在需要时注入上下文
    async loadSkillIfNeeded(skillName: string, context: Context): Promise<void> {
        const skill = this.skills.get(skillName);
        if (!skill) return;
        
        // 检查是否匹配当前任务
        if (this.matchesContext(skill, context)) {
            await this.injectSkillContext(skill);
        }
    }
    
    // 自动清理：任务完成后释放上下文
    async cleanupSkill(skillName: string): Promise<void> {
        this.skills.delete(skillName);
        await this.removeSkillContext(skillName);
    }
}</code></pre>
                        <pre class="code-block-panel " data-lang="python"><code class="language-python"># Skill 发现和加载机制
from dataclasses import dataclass
from pathlib import Path
import glob

@dataclass
class SkillConfig:
    name: str
    description: str
    triggers: list[str]  # 触发关键词
    files: list[str]     # 相关文件
    priority: int        # 加载优先级

class SkillManager:
    def __init__(self):
        self.skills: dict[str, SkillConfig] = {}
    
    # 渐进式发现：扫描目录中的 SKILL.md 文件
    async def discover_skills(self, directory: str) -> None:
        skill_files = glob.glob(f"{directory}/**/SKILL.md", recursive=True)
        
        for file in skill_files:
            content = await self.read_file(file)
            skill = self.parse_skill_file(content)
            
            if self.should_load_skill(skill, current_context):
                self.skills[skill.name] = skill
    
    # 按需加载：只在需要时注入上下文
    async def load_skill_if_needed(self, skill_name: str, context: Context) -> None:
        skill = self.skills.get(skill_name)
        if not skill:
            return
        
        # 检查是否匹配当前任务
        if self.matches_context(skill, context):
            await self.inject_skill_context(skill)
    
    # 自动清理：任务完成后释放上下文
    async def cleanup_skill(self, skill_name: str) -> None:
        del self.skills[skill_name]
        await self.remove_skill_context(skill_name)</code></pre>
                    </div>
                </div>
            </div>
            
            <div class="discovery-patterns">
                <h3>🔍 发现模式详解</h3>
                
                <div class="pattern-grid">
                    <div class="pattern-card">
                        <h4>1. 关键词触发</h4>
                        <p>通过 SKILL.md 中的描述和文件名匹配用户输入</p>
                        <div class="pattern-example">
                            <strong>示例：</strong>
                            <pre><code class="language-markdown">---
name: weather
description: Get weather forecasts
triggers: ["weather", "forecast", "temperature"]
---

# Weather Skill
When user asks about weather, use this skill.</code></pre>
                        </div>
                    </div>
                    
					<div class="pattern-card">
                        <h4>2. 目录感知</h4>
                        <p>根据当前工作目录自动加载相关 Skill</p>
                        <div class="pattern-example">
                            <strong>示例：</strong>
                            <pre><code class="language-typescript">// 在项目根目录加载项目特定 Skill
if (cwd.includes('frontend')) {
    await loadSkill('react-best-practices');
} else if (cwd.includes('backend')) {
    await loadSkill('api-design-patterns');
}</code></pre>
                        </div>
                    </div>
                    
                    <div class="pattern-card">
                        <h4>3. 上下文感知</h4>
                        <p>根据对话内容智能推荐相关 Skill</p>
                        <div class="pattern-example">
                            <strong>示例：</strong>
                            <pre><code class="language-python"># 分析对话上下文
context_keywords = extract_keywords(conversation_history)
matching_skills = find_skills_by_keywords(context_keywords)

# 智能推荐
for skill in matching_skills:
    if skill.relevance_score > 0.8:
        recommend_skill(skill)</code></pre>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="performance-benefits">
                <h3>⚡ 性能优势</h3>
                
                <div class="comparison-table">
                    <table>
                        <thead>
                            <tr>
                                <th>指标</th>
                                <th>传统方式 (System Prompt)</th>
                                <th>渐进式披露 (Skills)</th>
                                <th>改进</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>初始 Token 消耗</strong></td>
                                <td>高 (所有知识一次性加载)</td>
                                <td>低 (仅加载基础框架)</td>
                                <td>🚀 减少 80%</td>
                            </tr>
                            <tr>
                                <td><strong>上下文大小</strong></td>
                                <td>大 (持续占用)</td>
                                <td>小 (按需加载)</td>
                                <td>📉 减少 70%</td>
                            </tr>
                            <tr>
                                <td><strong>响应速度</strong></td>
                                <td>慢 (处理大量上下文)</td>
                                <td>快 (精简上下文)</td>
                                <td>⚡ 提升 60%</td>
                            </tr>
                            <tr>
                                <td><strong>知识更新</strong></td>
                                <td>困难 (需更新系统提示)</td>
                                <td>简单 (更新 Skill 文件)</td>
                                <td>🔄 更灵活</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="real-world-example">
                <h3>🌍 实际应用示例</h3>
                
                <div class="example-scenario">
                    <h4>场景：开发 React 应用</h4>
                    <div class="scenario-flow">
                        <div class="flow-step">
                            <strong>1. 用户输入</strong>
                            <pre><code class="language-bash">请帮我创建一个 React 组件，需要使用 useState 和 useEffect</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>2. Skill 发现</strong>
                            <pre><code class="language-typescript">// 系统检测到关键词: "React", "useState", "useEffect"
const matchingSkills = await skillManager.discover({
    keywords: ["react", "hooks", "component"],
    directory: currentWorkingDirectory
});
// 发现: react-best-practices.skill.md</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>3. 按需加载</strong>
                            <pre><code class="language-typescript">// 只加载 React 相关知识
await skillManager.loadSkill('react-best-practices', {
    context: "创建 React 组件",
    requirements: ["useState", "useEffect"]
});</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>4. 执行任务</strong>
                            <pre><code class="language-typescript">// AI 使用加载的知识创建组件
const component = await createReactComponent({
    hooks: ["useState", "useEffect"],
    bestPractices: loadedSkill.rules
});</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>5. 自动清理</strong>
                            <pre><code class="language-typescript">// 任务完成后清理上下文
await skillManager.cleanupSkill('react-best-practices');
// 释放内存，准备下一个任务</code></pre>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="best-practices">
                <h3>💡 最佳实践</h3>
                
                <div class="practice-grid">
                    <div class="practice-card">
                        <h4>✅ 推荐做法</h4>
                        <ul>
                            <li>在 SKILL.md 中明确描述触发条件</li>
                            <li>使用具体的关键词作为触发器</li>
                            <li>保持 Skill 文件精简 focused</li>
                            <li>定期清理不再使用的 Skill</li>
                            <li>为不同场景创建专用 Skill</li>
                        </ul>
                    </div>
                    
                    <div class="practice-card">
                        <h4>❌ 避免的做法</h4>
                        <ul>
                            <li>在单个 Skill 中包含过多知识</li>
                            <li>使用模糊的触发关键词</li>
                            <li>在 System Prompt 中硬编码所有知识</li>
                            <li>忽略 Skill 的版本管理</li>
                            <li>不清理已加载的 Skill 上下文</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

</main>

    <footer>
        <p><a href="index.html">返回首页</a> | 基于 Claude Code v2.1.88 源码分析</p>
    </footer>

    <script>
        mermaid.initialize({ 
            startOnLoad: true, 
            theme: 'default',
            securityLevel: 'loose',
            flowchart: { useMaxWidth: true, htmlLabels: true }
        });

        // 返回顶部按钮
        const backToTop = document.createElement('div');
        backToTop.className = 'back-to-top';
        backToTop.innerHTML = '↑';
        backToTop.onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});
        document.body.appendChild(backToTop);

        window.addEventListener('scroll', () => {
            if (window.scrollY > 300) {
                backToTop.style.display = 'flex';
            } else {
                backToTop.style.display = 'none';
            }
        });

        // 平滑滚动
        document.querySelectorAll('nav a').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                if (href.startsWith('#')) {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        });

        console.log('🔍 Skills 机制分析已加载');
    </script>

    <script src="js/app.js"></script>
