                            </tr>
                            <tr>
                                <td><strong>响应速度</strong></td>
                                <td>慢 (处理大量上下文)</td>
                                <td>快 (精简上下文)</td>
                                <td>⚡ 提升 60%</td>
                            </tr>
                            <tr>
                                <td><strong>知识更新</strong></td>
                                <td>困难 (需更新系统提示)</td>
                                <td>简单 (更新 Skill 文件)</td>
                                <td>🔄 更灵活</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="real-world-example">
                <h3>🌍 实际应用示例</h3>
                
                <div class="example-scenario">
                    <h4>场景：开发 React 应用</h4>
                    <div class="scenario-flow">
                        <div class="flow-step">
                            <strong>1. 用户输入</strong>
                            <pre><code class="language-bash">请帮我创建一个 React 组件，需要使用 useState 和 useEffect</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>2. Skill 发现</strong>
                            <pre><code class="language-typescript">// 系统检测到关键词: "React", "useState", "useEffect"
const matchingSkills = await skillManager.discover({
    keywords: ["react", "hooks", "component"],
    directory: currentWorkingDirectory
});
// 发现: react-best-practices.skill.md</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>3. 按需加载</strong>
                            <pre><code class="language-typescript">// 只加载 React 相关知识
await skillManager.loadSkill('react-best-practices', {
    context: "创建 React 组件",
    requirements: ["useState", "useEffect"]
});</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>4. 执行任务</strong>
                            <pre><code class="language-typescript">// AI 使用加载的知识创建组件
const component = await createReactComponent({
    hooks: ["useState", "useEffect"],
    bestPractices: loadedSkill.rules
});</code></pre>
                        </div>
                        
                        <div class="flow-step">
                            <strong>5. 自动清理</strong>
                            <pre><code class="language-typescript">// 任务完成后清理上下文
await skillManager.cleanupSkill('react-best-practices');
// 释放内存，准备下一个任务</code></pre>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="best-practices">
                <h3>💡 最佳实践</h3>
                
                <div class="practice-grid">
                    <div class="practice-card">
                        <h4>✅ 推荐做法</h4>
                        <ul>
                            <li>在 SKILL.md 中明确描述触发条件</li>
                            <li>使用具体的关键词作为触发器</li>
                            <li>保持 Skill 文件精简 focused</li>
                            <li>定期清理不再使用的 Skill</li>
                            <li>为不同场景创建专用 Skill</li>
                        </ul>
                    </div>
                    
                    <div class="practice-card">
                        <h4>❌ 避免的做法</h4>
                        <ul>
                            <li>在单个 Skill 中包含过多知识</li>
                            <li>使用模糊的触发关键词</li>
                            <li>在 System Prompt 中硬编码所有知识</li>
                            <li>忽略 Skill 的版本管理</li>
                            <li>不清理已加载的 Skill 上下文</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
