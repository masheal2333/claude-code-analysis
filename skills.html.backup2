                </div>
                <div class="code-content">
                    <pre class="code-panel " data-lang="typescript"><code>// tools/SkillTool.ts

interface SkillToolParams {
  skill: string;
  command?: string;
  args?: Record<string, any>;
}

class SkillTool implements Tool {
  name = 'skill';
  description = 'Execute a skill to perform specialized tasks';
  
  async execute(params: SkillToolParams): Promise<ToolResult> {
    // 1. 加载 Skill
    const skill = await loadSkill(params.skill);
    
    // 2. 获取 Prompt
    const prompt = await skill.getPromptForCommand(params.command);
    
    // 3. 通过 tool_result 注入
    return {
      type: 'tool_result',
      content: prompt,
      metadata: {
        skillName: skill.name,
        skillPath: skill.path
      }
    };
  }
}

// Skill Prompt 注入机制
async function injectSkillPrompt(
  skill: SkillDefinition,
  command?: string
): Promise<string> {
  // 读取 SKILL.md 内容
  const content = await readFile(skill.path);
  
  // 解析 Markdown
  const sections = parseMarkdown(content);
  
  // 根据命令提取相关部分
  if (command) {
    return extractCommandSection(sections, command);
  }
  
  return content;
}</code></pre>
                    <pre class="code-panel active" data-lang="python"><code># tools/skill_tool.py

from dataclasses import dataclass
from typing import Any, Dict, Optional

@dataclass
class SkillToolParams:
    skill: str
    command: Optional[str] = None
    args: Optional[Dict[str, Any]] = None

class SkillTool:
    name = "skill"
    description = "Execute a skill to perform specialized tasks"
    
    async def execute(self, params: SkillToolParams) -> Dict[str, Any]:
        # 1. 加载 Skill
        skill = await load_skill(params.skill)
        
        # 2. 获取 Prompt
        prompt = await skill.get_prompt_for_command(params.command)
        
        # 3. 通过 tool_result 注入
        return {
            "type": "tool_result",
            "content": prompt,
            "metadata": {
                "skill_name": skill.name,
                "skill_path": skill.path
            }
        }

# Skill Prompt 注入机制
async def inject_skill_prompt(
    skill: SkillDefinition,
    command: Optional[str] = None
) -> str:
    # 读取 SKILL.md 内容
    content = await read_file(skill.path)
    
    # 解析 Markdown
    sections = parse_markdown(content)
    
    # 根据命令提取相关部分
    if command:
        return extract_command_section(sections, command)
    
    return content</code></pre>
