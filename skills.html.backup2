                            G -->|否| I[普通对话]
                        end

                        subgraph "执行层"
                            H --> J[Skill Tool]
                            J --> K[加载 Prompt]
                            K --> L[执行步骤]
                            L --> M[返回结果]
                        end

                        subgraph "知识注入层"
                            N[SKILL.md] --> O[Prompt 提取]
                            O --> P[tool_result 注入]
                            P --> Q[上下文扩展]
                        end

                        D --> H
                        M --> Q
                </div>
