        <section id="skill-discovery">
            <h2>🔍 Skill Discovery (智能发现)</h2>
            <div class="discovery-detail">
                <h3>🎯 发现机制</h3>
                <p>Claude Code 会根据上下文自动推荐相关的 Skill：</p>
                
                <div class="mermaid">
                    graph LR
                        A[用户输入] --> B[意图分析]
                        B --> C[关键词提取]
                        C --> D[匹配 Skill 描述]
                        D --> E[推荐列表]
                        E --> F[用户选择]
                        F --> G[执行 Skill]
                </div>
                
                <div class="discovery-code">
                    <h3>💻 实现代码</h3>
                    <div class="code-tabs">
                    <button class="code-tab " data-lang="typescript">TypeScript</button>
                    <button class="code-tab active" data-lang="python">Python</button>
                </div>
                <div class="code-content">
                    <pre class="code-panel " data-lang="typescript"><code>// skills/skillDiscovery.ts

interface SkillDiscoveryResult {
  skill: SkillDefinition;
  confidence: number;
  reason: string;
}

async function discoverSkills(
  userInput: string
): Promise<SkillDiscoveryResult[]> {
  // 1. 提取关键词
  const keywords = extractKeywords(userInput);
  
  // 2. 获取所有可用的 Skill
  const allSkills = await getAllSkills();
  
  // 3. 计算匹配度
  const results: SkillDiscoveryResult[] = [];
  
  for (const skill of allSkills) {
    const confidence = calculateConfidence(keywords, skill);
    
    if (confidence > 0.5) {  // 置信度阈值
      results.push({
        skill,
        confidence,
        reason: generateReason(keywords, skill)
      });
    }
  }
  
  // 4. 按置信度排序
  return results.sort((a, b) => b.confidence - a.confidence);
}

function calculateConfidence(
  keywords: string[],
  skill: SkillDefinition
): number {
  let score = 0;
  
  // 检查 Skill 名称
  if (keywords.some(k => skill.name.includes(k))) {
    score += 0.3;
  }
  
  // 检查 Skill 描述
  if (keywords.some(k => skill.description.includes(k))) {
    score += 0.4;
  }
  
  // 检查触发词
  if (skill.triggers?.some(t => keywords.includes(t))) {
    score += 0.3;
  }
  
  return score;
}</code></pre>
                    <pre class="code-panel active" data-lang="python"><code># skills/skill_discovery.py

from dataclasses import dataclass
from typing import List, Tuple

@dataclass
class SkillDiscoveryResult:
    skill: SkillDefinition
    confidence: float
    reason: str

async def discover_skills(
    user_input: str
) -> List[SkillDiscoveryResult]:
    # 1. 提取关键词
    keywords = extract_keywords(user_input)
    
    # 2. 获取所有可用的 Skill
    all_skills = await get_all_skills()
    
    # 3. 计算匹配度
    results = []
    
    for skill in all_skills:
        confidence = calculate_confidence(keywords, skill)
        
        if confidence > 0.5:  # 置信度阈值
            results.append(SkillDiscoveryResult(
                skill=skill,
                confidence=confidence,
                reason=generate_reason(keywords, skill)
            ))
    
    # 4. 按置信度排序
    return sorted(results, key=lambda r: r.confidence, reverse=True)

def calculate_confidence(
    keywords: List[str],
    skill: SkillDefinition
) -> float:
    score = 0.0
    
    # 检查 Skill 名称
    if any(k in skill.name for k in keywords):
        score += 0.3
    
    # 检查 Skill 描述
    if any(k in skill.description for k in keywords):
        score += 0.4
    
    # 检查触发词
    if skill.triggers and any(t in keywords for t in skill.triggers):
        score += 0.3
    
    return score</code></pre>
