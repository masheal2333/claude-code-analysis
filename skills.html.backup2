skill_dir = Path(".claude/skills/code-review")
skill_dir.mkdir(parents=True, exist_ok=True)

# 创建 SKILL.md
skill_content = """# Code Review Skill

## Description
Perform comprehensive code review with best practices.

## Usage
When user asks for code review, use this skill.

## Steps
1. Read the code file
2. Check for:
   - Code style violations
   - Potential bugs
   - Performance issues
   - Security vulnerabilities
3. Provide detailed feedback

## Triggers
- "review code"
- "check code quality"
- "code review"
"""

(skill_dir / "SKILL.md").write_text(skill_content)

# Skill 自动加载
# 当用户说 "review code" 时，会自动推荐此 Skill</code></pre>
