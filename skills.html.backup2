        <section id="loading-mechanism">
            <h2>🔄 加载机制详解</h2>
            <div class="loading-detail">
                <h3>📋 加载流程</h3>
                <div class="mermaid">
                    sequenceDiagram
                        participant User as 用户
                        participant CC as Claude Code
                        participant SL as Skill Loader
                        participant SM as Skill Matcher
                        participant ST as Skill Tool

                        User->>CC: 输入请求
                        CC->>SM: 分析意图
                        SM->>SL: 查找匹配的 Skill
                        SL->>SM: 返回 Skill 列表
                        SM->>CC: 推荐最佳匹配
                        CC->>User: 显示 Skill 推荐
                        User->>CC: 确认执行
                        CC->>ST: 调用 Skill Tool
                        ST->>ST: 加载 SKILL.md
                        ST->>ST: 解析 Prompt
                        ST->>CC: 注入 tool_result
                        CC->>User: 执行完成
                </div>
                
                <div class="loading-code">
                    <h3>💻 加载过程代码</h3>
                    <div class="code-tabs">
                    <button class="code-tab " data-lang="typescript">TypeScript</button>
                    <button class="code-tab active" data-lang="python">Python</button>
                </div>
                <div class="code-content">
                    <pre class="code-panel " data-lang="typescript"><code>// skills/loadSkill.ts

interface SkillDefinition {
  name: string;
  description: string;
  prompt: string;
  path: string;
  triggers?: string[];
  directoryTriggers?: Set<string>;
}

async function loadSkill(skillName: string): Promise<SkillDefinition> {
  // 1. 查找 Skill 文件
  const skillPath = await findSkillPath(skillName);
  
  // 2. 读取 SKILL.md
  const skillContent = await readFile(skillPath);
  
  // 3. 解析 Skill 定义
  const skill = parseSkillDefinition(skillContent);
  
  // 4. 注册到 Skill 注册表
  await registerSkill(skill);
  
  return skill;
}

async function findSkillPath(skillName: string): Promise<string> {
  // 查找顺序：
  // 1. 项目目录 .claude/skills/
  // 2. 用户目录 ~/.claude/skills/
  // 3. 内置 skills/
  // 4. 远程市场
  
  const searchPaths = [
    `.claude/skills/${skillName}/SKILL.md`,
    `~/.claude/skills/${skillName}/SKILL.md`,
    `skills/${skillName}/SKILL.md`
  ];
  
  for (const path of searchPaths) {
    if (await fileExists(path)) {
      return path;
    }
  }
  
  throw new Error(`Skill not found: ${skillName}`);
}</code></pre>
                    <pre class="code-panel active" data-lang="python"><code># skills/load_skill.py

from dataclasses import dataclass, field
from typing import List, Optional, Set
import os
from pathlib import Path

@dataclass
class SkillDefinition:
    name: str
    description: str
    prompt: str
    path: str
    triggers: Optional[List[str]] = None
    directory_triggers: Optional[Set[str]] = None

async def load_skill(skill_name: str) -> SkillDefinition:
    # 1. 查找 Skill 文件
    skill_path = await find_skill_path(skill_name)
    
    # 2. 读取 SKILL.md
    skill_content = await read_file(skill_path)
    
    # 3. 解析 Skill 定义
    skill = parse_skill_definition(skill_content)
    
    # 4. 注册到 Skill 注册表
    await register_skill(skill)
    
    return skill

async def find_skill_path(skill_name: str) -> str:
    # 查找顺序：
    # 1. 项目目录 .claude/skills/
    # 2. 用户目录 ~/.claude/skills/
    # 3. 内置 skills/
    # 4. 远程市场
    
    search_paths = [
        f".claude/skills/{skill_name}/SKILL.md",
        f"{Path.home()}/.claude/skills/{skill_name}/SKILL.md",
        f"skills/{skill_name}/SKILL.md"
    ]
    
    for path in search_paths:
        if await file_exists(path):
            return path
    
    raise FileNotFoundError(f"Skill not found: {skill_name}")</code></pre>
